# /srv/grid-authority/.env on the host. Owned by the grid user, mode 600.
#
# Read by the scheduler, and inherited by the Python workers it spawns. These write,
# so this file carries the OWNER role.
#
# The API does not read this file. It reads .env.api, which carries a read-only role.
#
# Never commit this file. .env is gitignored; this example carries no real values.

# EIA open-data key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# The owner role — grid_owner, not grid_api. Migrations, sync-zones and every ingest
# job write through this, so a read-only role here fails at the first CREATE TABLE.
#
# The password is the one you chose in the runbook at 2.5:
#   CREATE ROLE grid_owner LOGIN PASSWORD '...'
#
# If it contains any of : / ? # [ ] @ or a space, percent-encode it here.
DATABASE_URL=postgresql://grid_owner:THE_PASSWORD_YOU_CHOSE@127.0.0.1:5432/grid_authority

# pino level for the scheduler: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# Must be UTC. The database and every process have to agree, or an interval-start
# hour stops meaning what it says.
TZ=UTC
