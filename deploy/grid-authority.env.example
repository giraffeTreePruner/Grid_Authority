# /srv/grid-authority/.env on the host. Owned by the grid user, mode 600.
#
# Never commit this file. .env is gitignored; this example carries no values.

# EIA open-data key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# The API role, not the owner. See the runbook for how it is created.
DATABASE_URL=postgresql://grid_api:CHANGE_ME@127.0.0.1:5432/grid_authority

PORT=3000
HOST=127.0.0.1
NODE_ENV=production
LOG_LEVEL=info

# Also the only origin CORS accepts.
PUBLIC_BASE_URL=https://grid.example.org

# Must be UTC. The database, the container and these processes have to agree.
TZ=UTC

# Bump when zones.pmtiles is rebuilt, to bust the immutable cache.
GEOMETRY_VERSION=1
