# Copy to .env and fill in. .env is gitignored and must never be committed.

# EIA API key — https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# PostgreSQL 16 connection string
DATABASE_URL=

# API server
PORT=
NODE_ENV=
LOG_LEVEL=

# Public origin of the deployed site; also the only allowed CORS origin
PUBLIC_BASE_URL=

# Always UTC. Container and Postgres must agree.
TZ=

# Cache-busting version for the committed zones.pmtiles artifact
GEOMETRY_VERSION=
