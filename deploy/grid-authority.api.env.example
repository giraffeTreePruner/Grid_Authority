# /srv/grid-authority/.env.api on the host. Owned by the grid user, mode 600.
#
# Read by the API process only, through Node's --env-file. It holds the read-only
# database role, so a bug in the API cannot write whatever it intends to.
#
# Never commit this file.

# The read-only role. Note grid_api, not grid_owner.
DATABASE_URL=postgresql://grid_api:CHANGE_ME_API@127.0.0.1:5432/grid_authority

PORT=3000
HOST=127.0.0.1
NODE_ENV=production
LOG_LEVEL=info

# The public origin, and the only origin CORS accepts.
PUBLIC_BASE_URL=https://grid.example.org

TZ=UTC
GEOMETRY_VERSION=1
